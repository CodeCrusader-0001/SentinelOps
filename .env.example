# SentinelOps Configuration Example
# Copy this file to .env and configure your environment

# Environment & Server
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_super_secret_key_in_production_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL by default; fallback to SQLite supported for local dev)
DATABASE_URL=postgresql+psycopg2://sentinelops:sentinelops_password@localhost:5432/sentinelops_db
# For lightweight local SQLite:
# DATABASE_URL=sqlite:///./sentinelops.db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# AI & LLM Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Anomaly Detection Settings
ANOMALY_DETECTOR_TYPE=deeplog  # options: deeplog, rule_based
DEEPLOG_MODEL_PATH=backend/app/detection/models/deeplog_lstm.pth
DEEPLOG_VOCAB_PATH=backend/app/detection/models/vocab.pkl
DEEPLOG_TOP_G=5
DEEPLOG_WINDOW_SIZE=10

# RAG & Knowledge Base
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_INDEX_PATH=backend/app/rag/storage/faiss_index.bin
RAG_METADATA_PATH=backend/app/rag/storage/metadata.pkl
RAG_SIMILARITY_THRESHOLD=0.35

# Remediation Security
REMEDIATION_REQUIRE_APPROVAL=true
